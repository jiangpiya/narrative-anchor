{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/preload",
    "noEmit": false,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/main/**/*", "src/renderer/**/*"]
}