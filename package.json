{
  "name": "narrative-anchor",
  "version": "1.0.0",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:preload && npm run copy:migrations",
    "build:preload": "tsc -p tsconfig.preload.json",
    "copy:migrations": "node -e \"const fs=require('fs'); fs.cpSync('src/main/database/migrations', 'dist/main/database/migrations', {recursive:true})\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "io.github.jiangpiya.narrativeanchor",
    "productName": "叙事锚点",
    "copyright": "Copyright © 2026 胡成辉",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/**/*.map",
      "!dist/main/**/*.map",
      "node_modules/**/*",
      "!node_modules/.vite",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "src/main/database/migrations",
        "to": "database/migrations",
        "filter": ["**/*.sql"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
