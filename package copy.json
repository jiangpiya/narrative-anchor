{
  "name": "narrative-anchor",
  "version": "1.0.0",
  "description": "Narrative Anchor - Electron + Vue 3 + TypeScript 应用",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dist": "npm run build && electron-builder",
    "build": "vite build && npm run build:preload && npm run copy:migrations",
    "build:preload": "tsc -p tsconfig.preload.json",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write .",
    "postinstall": "electron-rebuild",
    "copy:migrations": "node -e \"const fs=require('fs'); const src='src/main/database/migrations'; const dest='dist/main/database/migrations'; if(fs.existsSync(src)){ fs.cpSync(src, dest, {recursive: true}); console.log('Migrations copied'); } else { console.log('Source migrations not found'); }\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-store": "^1.3.1",
    "@types/howler": "^2.2.12",
    "@types/lodash": "^4.17.24",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^41.1.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vue-tsc": "^1.8.25"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-store": "^8.2.0",
    "howler": "^2.2.4",
    "lodash": "^4.18.1",
    "mammoth": "^1.12.0",
    "marked": "^11.2.0",
    "pinia": "^2.3.1",
    "sqlite3": "^6.0.1",
    "vue": "^3.3.8",
    "vue-router": "^4.6.4"
  }
}
